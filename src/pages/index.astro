---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const sortedPosts = getSortedPosts(await getCollection("posts"));
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.slice(0, config.posts.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "2-digit",
    year: "numeric",
    timeZone: config.site.timezone,
  }).format(date);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout academic-home"
  >
    <section aria-labelledby="profile-heading">
      <h1 id="profile-heading">Lan Luo</h1>
      <p class="profile-subtitle">
        Undergraduate Student @ East China Normal University
      </p>
      <div class="profile-grid">
        <div class="profile-intro">
          <p>
            Hi, I am <strong>Lan Luo <span lang="zh-CN">(罗澜)</span></strong>.
          </p>
          <p>
            I am an undergraduate student at East China Normal University. My
            interests lie in spatial artificial intelligence (GeoAI), embodied
            intelligence, and multimodal systems.
          </p>
          <p>
            I am interested in how intelligent systems perceive and understand
            the world, connect language with spatial information, and turn
            understanding into action.
          </p>
          <p>
            I write about paper reading, experiments, and engineering practice
            on my <a href="/posts/">blog</a>. This is also a place to keep track
            of questions, ideas, and what I learn while building things. <a
              href="/about/">More about me</a
            >.
          </p>
        </div>
        <aside class="profile-sidebar" aria-label="Profile and links">
          <img
            src="/profile-avatar.jpg"
            alt="Lan Luo's GitHub avatar"
            width="460"
            height="460"
            class="profile-avatar"
            fetchpriority="high"
          />
          <p class="profile-affiliation">East China Normal University</p>
          <p class="profile-role">Undergraduate Student</p>
          <Socials />
          <a class="profile-github" href="https://github.com/rileyluolan"
            >@rileyluolan</a
          >
        </aside>
      </div>
    </section>

    <section class="home-section" aria-labelledby="interests-heading">
      <h2 id="interests-heading">Research Interests</h2>
      <ul class="research-interests">
        <li>Spatial artificial intelligence (GeoAI)</li>
        <li>Embodied intelligence and multimodal systems</li>
        <li>Vision-language navigation and UAV systems</li>
        <li>Research engineering and evaluation workflows</li>
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section class="home-section" aria-labelledby="featured-heading">
          <h2 id="featured-heading">Featured Writing</h2>
          <ul class="dated-posts">
            {featuredPosts.map(post => (
              <li>
                <time datetime={post.data.pubDatetime.toISOString()}>
                  {formatDate(post.data.pubDatetime)}
                </time>
                <a href={getPostUrl(post.id, post.filePath, locale)}>
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="home-section latest-posts" aria-labelledby="latest-heading">
      <div class="section-heading">
        <h2 id="latest-heading"><a href="/posts/">Latest Posts</a></h2>
        <a class="all-posts" href="/posts/">All posts →</a>
      </div>
      <ul class="dated-posts">
        {
          recentPosts.map(post => (
            <li>
              <time datetime={post.data.pubDatetime.toISOString()}>
                {formatDate(post.data.pubDatetime)}
              </time>
              <a href={getPostUrl(post.id, post.filePath, locale)}>
                {post.data.title}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="writing-note">
        Notes on research, experiments, and learning. Written in English and
        Chinese. <a href="/rss.xml">RSS</a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    if (indexLayout?.layout)
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? "/");
  });
</script>
